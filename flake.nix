{
  description = "crank production workspace (ADR-0001 §9)";
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    crane.url = "github:ipetkov/crane";
    rust-overlay.url = "github:oxalica/rust-overlay";
    # RustSec database for the `deny` check (ADR-0001 §9.5): pinned, so the sandbox needs no network.
    advisory-db = { url = "github:rustsec/advisory-db"; flake = false; };
  };
  outputs = { self, nixpkgs, crane, rust-overlay, advisory-db }: let
    systems = [ "aarch64-darwin" "x86_64-linux" ];
    eachSystem = nixpkgs.lib.genAttrs systems;
    project = system: let
      pkgs = import nixpkgs { inherit system; overlays = [ rust-overlay.overlays.default ]; };
      inherit (pkgs) lib;
      toolchain = pkgs.rust-bin.fromRustupToolchainFile ./rust-toolchain.toml;
      craneLib = (crane.mkLib pkgs).overrideToolchain toolchain;
      source = fileset: lib.fileset.toSource { root = ./.; inherit fileset; };
      cargoFiles = lib.fileset.difference (craneLib.fileset.commonCargoSources ./.) ./crates/crank-fec/fuzz;
      rustFiles = lib.fileset.unions [ cargoFiles ./crates/crank-ble/proptest-regressions ./crates/crank-store/migrations ./crates/crank-store/tests/fixtures ./crates/crank-fec/tests/fixtures ./crates/crank-engine/tests/fixtures ./docs/hil/captures/check4.fecap ./clippy.toml ./.config/nextest.toml ./crates/crank-domain/tests/vectors ./crates/crank-domain/tests/fixtures ./crates/crank-domain/DIVERGENCES.md ./scripts/relocate-tauri-permissions.py ./spec/knowledge-pack/rules.md
        ./app/src-tauri/tauri.conf.json ./app/src-tauri/capabilities ./app/src-tauri/Info.plist ./app/src-tauri/icons ];
      frontendSrc = source (lib.fileset.unions [
        (lib.fileset.difference ./app ./app/src-tauri) ./shared ./assets/brand
        ./crates/crank-domain/tests/vectors ./crates/crank-domain/tests/fixtures
        ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ]);
      pnpmDeps = pkgs.fetchPnpmDeps {
        pname = "crank"; src = frontendSrc; pnpm = pkgs.pnpm_12;
        # pnpm 12 --force still filters optional dependencies by host platform.
        # Fetch both supported targets so one hash works on macOS and Linux. The platform-list form (pnpm >= 12.5)
        # prepares exactly these two; the os/cpu mapping would fetch their cross product (4 targets, #64).
        prePnpmInstall = ''pnpm config set --location=project --json supportedArchitectures '["darwin-arm64","linux-x64"]' '';
        # pnpm leaves an empty v11/links directory on macOS but not Linux.
        # Empty store directories carry no cache data; normalize before packing.
        postInstall = ''find "$storePath" -type d -empty -delete'';
        fetcherVersion = 4; hash = "sha256-vXa9T4Z10I53+L/3womR+RLALIddxrTrAmFg4L1ZPGk=";
      };
      frontend = name: command: pkgs.stdenvNoCC.mkDerivation {
        pname = name; version = "0.1.0"; src = frontendSrc;
        inherit pnpmDeps;
        nativeBuildInputs = [ pkgs.nodejs pkgs.pnpm_12 pkgs.pnpmConfigHook ];
        buildPhase = command;
        installPhase = "mkdir -p $out; cp -r app/dist/. $out/";
      };
      appDist = frontend "crank-app-dist" "pnpm -C app build";
      cargoVendorDir = craneLib.vendorCargoDeps { cargoLock = ./Cargo.lock; };
      # tauri-plugin-wdio-webdriver 1.5.0 omits permissions/autogenerated/reference.md. Its build script
      # (tauri_plugin::Builder) writes generated files next to the manifest, which is read-only in the Nix
      # vendor tree; the builder skips a write whose bytes already match, so supplying that one file makes
      # the unmodified crate build (#241). The vendor dir is used by the e2e package only (#233): every other
      # build keeps the plain one and never compiles the plugin. Only that crate is overridden. Upstream
      # report webdriverio/desktop-mobile#730; see nix/patches/README.md.
      cargoVendorDirE2e = craneLib.vendorCargoDeps {
        cargoLock = ./Cargo.lock;
        overrideVendorCargoPackage = p: drv:
          if p.name == "tauri-plugin-wdio-webdriver"
          then assert lib.assertMsg (p.version == "1.5.0")
            "tauri-plugin-wdio-webdriver ${p.version}: the reference.md workaround is pinned to 1.5.0; re-check upstream and see nix/patches/README.md";
          drv.overrideAttrs (_: {
            postPatch = ''
              install -Dm644 ${./nix/patches/tauri-plugin-wdio-webdriver/reference.md} permissions/autogenerated/reference.md
            '';
          })
          else drv;
      };
      common = {
        pname = "crank"; version = "0.1.0"; src = source rustFiles;
        inherit cargoVendorDir;
        strictDeps = true;
        nativeBuildInputs = [ pkgs.pkg-config ];
        buildInputs = lib.optionals pkgs.stdenv.hostPlatform.isLinux [
          pkgs.webkitgtk_4_1 pkgs.gtk3 pkgs.libsoup_3 pkgs.openssl pkgs.dbus ];
        # Rust checks share crane's default release-profile artifacts.
        cargoExtraArgs = "--workspace --locked";
      };
      cargoArtifacts = craneLib.buildDepsOnly (common // { src = source cargoFiles; });
      rustCheck = common // {
        inherit cargoArtifacts;
        nativeBuildInputs = common.nativeBuildInputs ++ [ pkgs.python3 ];
        postConfigure = "python3 scripts/relocate-tauri-permissions.py";
      };
      desktop = features: craneLib.buildPackage (rustCheck // {
        cargoVendorDir = if lib.hasInfix "e2e" features then cargoVendorDirE2e else cargoVendorDir;
        pname = "crank-desktop"; cargoExtraArgs = "--locked -p crank-desktop --bin crank-desktop --features custom-protocol${features}";
        doCheck = false;
        preBuild = ''export TAURI_CONFIG='{"build":{"frontendDist":"${appDist}"}}' '';
      });
      cli = craneLib.buildPackage (rustCheck // {
        pname = "crank-cli"; cargoExtraArgs = "--locked -p crank-cli"; doCheck = false;
      });
      # ADR-0001 §9.3: file layout only. Tauri's bundler and codesign do not run in the
      # sandbox; `just bundle` copies this to ~/Applications and signs it with nix-tcc.
      crankApp = pkgs.runCommand "crank-app" { } ''
        app=$out/crank.app/Contents
        mkdir -p $app/MacOS $app/Resources
        install -m755 ${desktop ""}/bin/crank-desktop $app/MacOS/crank-desktop
        install -m755 ${cli}/bin/crank $app/MacOS/crank
        install -m644 ${./app/src-tauri/icons/icon.icns} $app/Resources/icon.icns
        install -m644 ${./app/src-tauri/Info.plist} $app/Info.plist
      '';
      # deny.toml (root) and deny-fuzz.toml (fuzz workspace, #199) stay the policy files; Nix only injects
      # where the database lives. cargo-deny needs a git checkout it can lock, so the pinned input is
      # copied into one at build time.
      denyConfigFor = policy: (pkgs.formats.toml { }).generate "deny.toml" (let cfg = builtins.fromTOML (builtins.readFile policy); in
        cfg // { advisories = cfg.advisories // { db-path = "@advisoryDbRoot@"; }; });
      # RustSec advisories run offline against the pinned `advisory-db` input (ADR-0001 §9.5, #124).
      # The directory name is cargo-deny's hash of the default db URL (see AGENTS.md).
      denyCheck = { pname, src, cargoDenyChecks, policy ? ./deny.toml, manifest ? "Cargo.toml", cargoVendorDir ? null }:
        craneLib.cargoDeny ({
          inherit pname; version = "0.1.0"; inherit src cargoDenyChecks;
          cargoDenyExtraArgs = "--offline --manifest-path ${manifest} --config $TMPDIR/deny.toml";
          nativeBuildInputs = [ pkgs.git ];
          preBuild = ''
            export advisoryDbRoot=$TMPDIR/advisory-dbs
            db=$advisoryDbRoot/advisory-db-3157b0e258782691
            mkdir -p $db && cp -R ${advisory-db}/. $db && chmod -R u+w $db
            substitute ${denyConfigFor policy} $TMPDIR/deny.toml --subst-var advisoryDbRoot
            export GIT_AUTHOR_NAME=nix GIT_AUTHOR_EMAIL=nix@invalid GIT_COMMITTER_NAME=nix GIT_COMMITTER_EMAIL=nix@invalid
            export GIT_AUTHOR_DATE="@${toString advisory-db.lastModified}" GIT_COMMITTER_DATE="@${toString advisory-db.lastModified}"
            git -C $db init -q && git -C $db add -A && git -C $db commit -q -m pinned
          '';
        } // lib.optionalAttrs (cargoVendorDir != null) { inherit cargoVendorDir; });
      checks = {
        build = desktop "";
        # The e2e package must keep building where CI runs (ADR-0001 §8.3, #35); the harness itself is `just e2e`.
        build-e2e = desktop ",e2e";
        fmt = craneLib.cargoFmt { pname = "crank"; version = "0.1.0"; src = source cargoFiles; };
        clippy = craneLib.cargoClippy (rustCheck // { cargoClippyExtraArgs = "--features crank-ble/replay,crank-ble/hil --all-targets -- -D warnings"; });
        nextest = craneLib.cargoNextest (rustCheck // { cargoNextestExtraArgs = "--features crank-ble/replay,crank-ble/hil"; });
        doctest = craneLib.cargoDocTest rustCheck;
        # crank-engine's dev-dependency on itself enables its `specta` feature in every test
        # build (#271), which hides the plain build; this check compiles the library alone (#252).
        # crank-engine declares no default features, so no feature flag is needed (#293).
        engine-no-features = craneLib.mkCargoDerivation (rustCheck // {
          buildPhaseCargoCommand = "cargo check --locked -p crank-engine";
          doInstallCargoArtifacts = false; installPhase = "touch $out";
        });
        doc = craneLib.cargoDoc (rustCheck // { RUSTDOCFLAGS = "-D warnings"; });
        deny = denyCheck {
          pname = "crank";
          src = source cargoFiles;
          cargoDenyChecks = "advisories bans licenses sources -A index-failure";
          # Yanked releases need the crates.io index, which the sandbox cannot reach: that
          # lint is silenced here and enforced by .github/workflows/advisories.yml (#181).
        };
        # crates/crank-fec/fuzz is its own workspace (dev-only, never shipped) with its own lockfile, so the
        # root `deny` never sees it. Same offline advisory gate, advisories only: bans/licenses/sources
        # are policy for shipped code and the fuzz workspace's libfuzzer-sys tree is not (#185).
        deny-fuzz = denyCheck {
          pname = "crank-fec-fuzz";
          src = source (lib.fileset.unions [ ./Cargo.toml ./crates/crank-fec/Cargo.toml ./crates/crank-fec/src
            ./crates/crank-fec/fuzz/Cargo.toml ./crates/crank-fec/fuzz/Cargo.lock ./crates/crank-fec/fuzz/fuzz_targets ]);
          cargoVendorDir = craneLib.vendorCargoDeps { cargoLock = ./crates/crank-fec/fuzz/Cargo.lock; };
          cargoDenyChecks = "advisories -A index-failure";
          policy = ./deny-fuzz.toml;
          manifest = "crates/crank-fec/fuzz/Cargo.toml";
        };
        bindings-drift = craneLib.mkCargoDerivation (rustCheck // {
          src = source (lib.fileset.unions [ rustFiles ./app/src/bindings.ts ]);
          buildPhaseCargoCommand = ''
            bindingsDir=$(mktemp -d)
            cargo run --release --locked -p crank-desktop --bin export-bindings -- "$bindingsDir/bindings.ts"
            diff -u app/src/bindings.ts "$bindingsDir/bindings.ts"
          '';
          doInstallCargoArtifacts = false; installPhase = "touch $out";
        });
        deps-edges = craneLib.mkCargoDerivation (rustCheck // {
          src = source (lib.fileset.unions [ rustFiles ./scripts/deps-edges.py ]);
          nativeBuildInputs = common.nativeBuildInputs ++ [ pkgs.python3 ];
          buildPhaseCargoCommand = ''
            productionMetadata=$(mktemp)
            cargo metadata --locked --format-version 1 --features crank-desktop/custom-protocol > "$productionMetadata"
            cargo metadata --locked --format-version 1 --all-features | python3 scripts/deps-edges.py "$productionMetadata"
          '';
          doInstallCargoArtifacts = false; installPhase = "touch $out";
        });
        scales-parity = craneLib.mkCargoDerivation (rustCheck // {
          src = source (lib.fileset.unions [ rustFiles
            (lib.fileset.difference ./app ./app/src-tauri) ./shared
            ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ]);
          inherit pnpmDeps;
          nativeBuildInputs = rustCheck.nativeBuildInputs ++ [ pkgs.nodejs pkgs.pnpm_12 pkgs.pnpmConfigHook ];
          buildPhaseCargoCommand = ''
            cargo run --release --locked -p crank-domain --example export_scale_edges > "$TMPDIR/rust-edges.json"
            CRANK_SCALE_EDGES="$TMPDIR/rust-edges.json" pnpm -C app exec vitest run tests/scales-parity.test.ts
          '';
          doInstallCargoArtifacts = false; installPhase = "touch $out";
        });
        # The Tauri icon set must be the output of `just icons` for the committed /C/ mark (#121).
        icons-drift = pkgs.runCommand "icons-drift" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/icons.py ./assets/icon/icon-1024.png ./app/src-tauri/icons ])} src
          cd src && python3 -I scripts/icons.py check
          touch $out
        '';
        # Public-repo hygiene (#122, #146): no internal hostnames or absolute home paths.
        public-hygiene = pkgs.runCommand "public-hygiene" { } ''
          sh ${./scripts/check-public-hygiene.sh} ${source (lib.fileset.gitTracked ./.)}
          touch $out
        '';
        # Window config follows DESIGN §8 (#123); every package.json is Apache-2.0 (#125).
        window-config = pkgs.runCommand "window-config" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 ${./scripts/check-window-config.py} ${source (lib.fileset.unions [ ./docs/design/DESIGN.md ./docs/design/sizes.json ./app/src-tauri/tauri.conf.json ])}
          touch $out
        '';
        # Regression test: the window-config check must fail on mismatched sources (#170).
        window-config-test = pkgs.runCommand "window-config-test" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 ${./scripts/test-window-config.py} ${source (lib.fileset.unions [ ./docs/design/DESIGN.md ./docs/design/sizes.json ./app/src-tauri/tauri.conf.json ])} ${./scripts/check-window-config.py}
          touch $out
        '';
        package-licenses = pkgs.runCommand "package-licenses" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 ${./scripts/check-licenses.py} ${source (lib.fileset.intersection (lib.fileset.gitTracked ./.) (lib.fileset.fileFilter (f: f.name == "package.json") ./.))}
          touch $out
        '';
        # Executable model of the trainer-following machine (ADR-0002 §4.4.1, #54), and the
        # committed fixture crank-engine's refinement test reads (#218): it must equal the model's output.
        following-model = pkgs.runCommand "following-model" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 ${./docs/adr/models/trainer_following.py} ${./docs/adr/0002-ble-trainer.md} ${./crates/crank-engine/tests/fixtures/following.json}
          touch $out
        '';
        # FMEA rows: schema, guards, table rendered from the TOML (#255); a missing cited test only
        # warns here, `just fmea` (--strict) fails on it.
        fmea = pkgs.runCommand "fmea" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          cp -r ${source (lib.fileset.unions [ ./docs/safety (lib.fileset.fileFilter (f: f.hasExt "rs" || f.hasExt "py") ./crates) ])} src
          python3 src/docs/safety/check_fmea.py src
          touch $out
        '';
        # e2e.sh's run-dir pruning must survive zero, one and many prior runs under `set -euo pipefail` (#233).
        e2e-prune = pkgs.runCommand "e2e-prune" { } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/e2e-lib.sh ./scripts/test-e2e-prune.sh ])} src
          cd src && bash scripts/test-e2e-prune.sh
          touch $out
        '';
        # `just test-changed`: file -> crate -> reverse-dependency mapping (#371).
        test-changed-test = pkgs.runCommand "test-changed-test" { nativeBuildInputs = [ pkgs.python3 pkgs.git ]; } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/test-changed.py ./scripts/test-test-changed.py ])} src
          cd src && python3 -I scripts/test-test-changed.py
          touch $out
        '';
        # App comments cite Rust as `file.rs symbol (~line)`, never a bare line number (#391).
        rust-citations = pkgs.runCommand "rust-citations" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 -I ${./scripts/check-rust-citations.py} ${source (lib.fileset.unions [ (lib.fileset.fileFilter (f: lib.any f.hasExt [ "ts" "tsx" "md" "css" "html" ]) ./app) (lib.fileset.fileFilter (f: f.hasExt "rs") ./crates) (lib.fileset.fileFilter (f: f.hasExt "rs") ./app/src-tauri) ])}
          touch $out
        '';
        rust-citations-test = pkgs.runCommand "rust-citations-test" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/check-rust-citations.py ./scripts/test-check-rust-citations.py ])} src
          cd src && python3 -I scripts/test-check-rust-citations.py
          touch $out
        '';
        npm-licenses-test = pkgs.runCommand "npm-licenses-test" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/check-npm-prod-licenses.py ./scripts/test-check-npm-prod-licenses.py ])} src
          cd src && python3 scripts/test-check-npm-prod-licenses.py
          touch $out
        '';
      } // lib.optionalAttrs pkgs.stdenv.hostPlatform.isDarwin {
        # just bundle is macOS-only (ADR-0001 §9.3): exercise its atomic install against a temp target (#165).
        install-app = pkgs.runCommand "install-app" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          cp -r ${source (lib.fileset.unions [ ./scripts/install-app.sh ./scripts/test-install-app.sh ])} src
          cd src && bash scripts/test-install-app.sh
          touch $out
        '';
      } // {
        # Production npm tree (bundled into the app) against the licence allow-list (#233).
        npm-prod-licenses = (frontend "npm-prod-licenses"
          "pnpm -C app licenses list --prod --json | python3 ${./scripts/check-npm-prod-licenses.py}").overrideAttrs (old: {
            nativeBuildInputs = old.nativeBuildInputs ++ [ pkgs.python3 ];
            installPhase = "touch $out";
          });
      } // lib.genAttrs [ "app-typecheck" "app-lint" "app-test" "shared-test" "shared-typecheck" "vectors-drift" ] (name:
        (frontend name (if name == "shared-test" then "pnpm -C shared test"
          else if name == "shared-typecheck" then "pnpm -C shared typecheck"
          else if name == "vectors-drift" then "pnpm -C shared exec vitest run scripts"
          else "pnpm -C app ${lib.removePrefix "app-" name}" )).overrideAttrs {
            installPhase = "touch $out";
          });
    in {
      inherit checks;
      packages = { app-dist = appDist; crank-desktop = desktop "";
        crank-desktop-e2e = desktop ",e2e";
        crank-cli = cli;
      } // lib.optionalAttrs pkgs.stdenv.hostPlatform.isDarwin { crank-app = crankApp; };
      devShells.fuzz = pkgs.mkShell {
        packages = [ (pkgs.rust-bin.selectLatestNightlyWith (t: t.minimal.override {
          extensions = [ "rust-src" ];
        })) pkgs.cargo-fuzz ];
      };
      devShells.default = craneLib.devShell {
        inputsFrom = [ (desktop "") ];
        packages = [ toolchain pkgs.nodejs pkgs.pnpm_12 pkgs.just pkgs.cargo-nextest
          pkgs.cargo-deny pkgs.cargo-fuzz pkgs.python3 ];
      };
    };
  in {
    checks = eachSystem (system: (project system).checks);
    packages = eachSystem (system: (project system).packages);
    devShells = eachSystem (system: (project system).devShells);
  };
}
